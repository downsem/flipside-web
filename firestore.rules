rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPostOwner() {
      return signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    function isIncomingPostOwner() {
      return signedIn()
        && request.resource.data.authorId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Main FlipSide posts / imported Flips / share-extension imports
    match /posts/{postId} {
      allow read: if true;
      allow create: if isIncomingPostOwner();
      allow update, delete: if isPostOwner();

      // AI generations and lens candidates attached to a post.
      match /{subcollection}/{docId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    // Decks generated by the iOS share extension and stored by the backend.
    // The app reads these by deckId and imports them into /posts as shareext_* docs.
    match /shareExtensionDecks/{deckId} {
      allow read: if true;
      allow write: if false;
    }

    // Events / analytics. Clients may create events, but should not edit them.
    match /events/{eventId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // Default deny for anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
